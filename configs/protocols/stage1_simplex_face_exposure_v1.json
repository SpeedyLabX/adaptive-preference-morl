  "learner_contract": {
    "algorithm": "SimplexPPO",
    "implementation": ["src/models/onpolicy.py", "src/models/lunar_onpolicy.py", "src/models/face_exposure_ppo.py"],
    "hindsight_relabeling": false,
    "scalarization_rule": "raw_utility_preserving_batch_standardized",
    "popart_algebraic_note": "Positive diagonal PopArt rescaling diag(sigma) e_i proportional to e_i leaves exact simplex vertices invariant; normalization distortion applies strictly to near-face mixed-weight regions, never exact corners.",
    "paired_initialization": true,
    "checkpoint_selection_rule": "final_fixed_budget_checkpoint_only_no_validation_selection",
    "budget_separation": {
      "training_interactions_matched": true,
      "actor_and_critic_updates_matched": true,
      "curriculum_eval_steps_accounted_separately": true,
      "development_eval_steps_accounted_separately": true,
      "final_test_steps_zero_until_post_lock_evaluation": true
    }
  },
  "arms": {
    "stage1a_primary_contrast": [
      {
        "id": "uniform",
        "kind": "static_baseline",
        "sampler": "FaceBalancedPreferenceSampler(mode='uniform')",
        "distribution": "i.i.d. Dirichlet(1_d) per episode on Delta^{d-1}",
        "curriculum_eval_overhead_steps": 0
      },
      {
        "id": "fixed_face_balanced",
        "kind": "static_intervention",
        "sampler": "FaceBalancedPreferenceSampler(mode='fixed_face_balanced')",
        "mixture_d_ge_3": {
          "interior_prob": 0.5,
          "vertex_prob": 0.25,
          "sparse_face_prob": 0.25,
          "sparse_face_support_sizes": "uniform over {2, ..., d - 1}"
        },
        "mixture_d_eq_2_sanity": {
          "interior_prob": 0.5,
          "vertex_prob": 0.5,
          "sparse_face_prob": 0.0
        },
        "curriculum_eval_overhead_steps": 0
      }
    ],
    "stage1b_conditional_adaptive_expansion": {
      "enabled_in_initial_sweep": false,
      "unlock_condition": "Unlocked ONLY after Stage-1A completes and coordinator+Gate review confirms residual boundary regret justifying adaptive allocation.",
      "arms": [
        {
          "id": "compute_matched_random",
          "kind": "static_random_control",
          "description": "Executes identical curriculum-evaluation steps as adaptive_face_balanced but updates allocation weights from random scores."
        },
        {
          "id": "adaptive_face_balanced",
          "kind": "adaptive_intervention",
          "description": "Outcome-dependent preference allocation over face-stratified support with matched total training + curriculum + update budgets."
        }
      ],
      "adaptive_benefit_decision_rule": "Claim adaptive benefit ONLY if adaptive_face_balanced beats BOTH fixed_face_balanced AND compute_matched_random on deployed face-cap regret at strictly matched total environment and optimizer budgets (Holm-adjusted paired permutation p < 0.05 and 95% paired bootstrap CI excluding 0) while satisfying the >= 98.5% interior-utility retention margin. If fixed_face_balanced ties or beats adaptive_face_balanced, report the static face-exposure sufficiency result honestly."
    },
    "secondary_minecart_2x2_normalization_control": {
      "env_id": "minecart-v0",
      "reward_dim": 3,
      "factors": {
        "exposure": ["uniform", "fixed_face_balanced"],
        "actor_scalarization": ["raw_utility_preserving", "uncompensated_popart_sigma_scaled"]
      },
      "implied_preference_w_hat_region": "near_face_mixed_weights_only",
      "reporting_rule": "Move to appendix if interaction and near-face distortion effect are null."
    }
  },
